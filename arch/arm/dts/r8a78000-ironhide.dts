/dts-v1/;
#include "r8a78000.dtsi"
#include <dt-bindings/net/ti-dp83869.h>

/ {
	model = "Renesas Ironhide board based on r8a78000";
	compatible = "renesas,ironhide", "renesas,r8a78000";

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		mmc0 = &mmc0;
		serial0 = &hscif0;
	};

	chosen {
		stdout-path = "serial0:1843200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	memory@1080000000 {
		device_type = "memory";
		reg = <0x10 0x80000000 0x0 0x80000000>;
	};

	memory@1200000000 {
		device_type = "memory";
		reg = <0x12 0x00000000 0x1 0x00000000>;
	};

	memory@1400000000 {
		device_type = "memory";
		reg = <0x14 0x00000000 0x1 0x00000000>;
	};

	memory@1600000000 {
		device_type = "memory";
		reg = <0x16 0x00000000 0x1 0x00000000>;
	};

	memory@1800000000 {
		device_type = "memory";
		reg = <0x18 0x00000000 0x1 0x00000000>;
	};

	memory@1a00000000 {
		device_type = "memory";
		reg = <0x1a 0x00000000 0x1 0x00000000>;
	};

	memory@1c00000000 {
		device_type = "memory";
		reg = <0x1c 0x00000000 0x1 0x00000000>;
	};

	memory@1e00000000 {
		device_type = "memory";
		reg = <0x1e 0x00000000 0x1 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ipl0: ipl0@40000000 {
			no-map;
			reg = <0x0 0x40000000 0x0 0xb800000>;
		};

		frtos_app: frtos_app@6b800000 {
			no-map;
			reg = <0x0 0x6b800000 0x0 0x1e800000>;
		};

		ipl1: ipl1@8b000000 {
			no-map;
			reg = <0x0 0x8b000000 0x0 0x3200000>;
		};

		ldr: ldr@8e200000 {
			no-map;
			reg = <0x0 0x8e200000 0x0 0x100000>;
		};

		cr52_ram0: cr52_ram0@96600000 {
			no-map;
			reg = <0x0 0x96600000 0x0 0x50000>;
		};

		cr52_ram1: cr52_ram1@96650000 {
			no-map;
			reg = <0x0 0x96650000 0x0 0x50000>;
		};

		cr52_ram2: cr52_ram2@966a0000 {
			no-map;
			reg = <0x0 0x966a0000 0x0 0x50000>;
		};

		cr52_ca720_share: cr52_ca720_share@966f0000 {
			no-map;
			reg = <0x0 0x966f0000 0x0 0x7f10000>;
		};

		ecc_data_region@10cccd0000 {
			no-map;
			reg = <0x10 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@12cccd0000 {
			no-map;
			reg = <0x12 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@14cccd0000 {
			no-map;
			reg = <0x14 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@16cccd0000 {
			no-map;
			reg = <0x16 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@18cccd0000 {
			no-map;
			reg = <0x18 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1acccd0000 {
			no-map;
			reg = <0x1a 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1ccccd0000 {
			no-map;
			reg = <0x1c 0xcccd0000 0x0 0x33330000>;
		};

		ecc_data_region@1ecccd0000 {
			no-map;
			reg = <0x1e 0xcccd0000 0x0 0x33330000>;
		};
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&extal_clk {
	clock-frequency = <16666600>;
};

&extalr_clk {
	clock-frequency = <32768>;
};

&hscif0 {
	pinctrl-0 = <&hscif0_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	eeprom@50 {
		compatible = "rohm,br24g01", "atmel,24c01";
		reg = <0x50>;
		pagesize = <8>;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&eth_pcs {
	phys = <&mp_phy 2 1>;
	status = "okay";
};

&mmc0 {
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-1 = <&mmc0_pins>;
	pinctrl-names = "default", "state_uhs";

	bus-width = <8>;
	full-pwr-cycle-in-suspend;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	no-sd;
	no-sdio;
	non-removable;

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;

	status = "okay";
};

&ufs0 {
	status = "okay";
};

&ufs1 {
	status = "okay";
};

&mp_phy {
	status = "okay";
};

&pfc {
	pinctrl-0 = <&scif_clk_pins>;
	pinctrl-names = "default";

	eth25g2_pins: eth25g2 {
		groups = "eth25g2_mdio", "eth25g2_link", "eth25g2_phyint";
		function = "eth25g2";
		drive-strength = <24>;
	};

	ethes0_pins: ethes0 {
		groups = "ethes0_match", "ethes0_capture", "ethes0_pps";
		function = "ethes0";
		drive-strength = <24>;
	};

	hscif0_pins: hscif0 {
		groups = "hscif0_data", "hscif0_ctrl";
		function = "hscif0";
	};

	i2c0_pins: i2c0 {
		groups = "i2c0";
		function = "i2c0";
	};

	i2c1_pins: i2c1 {
		groups = "i2c1";
		function = "i2c1";
	};

	mmc0_pins: mmc0 {
		groups = "mmc0_data8", "mmc0_ctrl", "mmc0_ds";
		function = "mmc0";
		drive-strength = <24>;
	};

	rsw3_pins: rsw3 {
		groups = "rsw3_match", "rsw3_capture", "rsw3_pps";
		function = "rsw3";
		drive-strength = <24>;
	};

	scif_clk_pins: scif-clk {
		groups = "scif_clk";
		function = "scif_clk";
	};

	usb30_pins: usb0 {
		//groups = "usb0_vbus", "usb0";
		//function = "usb0";
		mux {
			groups = "usb0_vbus", "usb0";
			function = "usb0";
		};

		ovc {
			pins = "GP_10_1";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_0";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_2";
			bias-pull-up;
		};
	};

	usb20_pins: usb1 {
		//groups = "usb1_vbus", "usb1";
		//function = "usb1";
		mux {
			groups = "usb1_vbus", "usb1";
			function = "usb1";
		};

		ovc {
			pins = "GP_10_4";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_3";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_5";
			bias-pull-up;
		};
	};

	usb31_pins: usb2 {
		//groups = "usb2_vbus", "usb2";
		//function = "usb2";
		mux {
			groups = "usb2_vbus", "usb2";
			function = "usb2";
		};

		ovc {
			pins = "GP_10_7";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_6";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_8";
			bias-pull-up;
		};
	};

	usb21_pins: usb3 {
		//groups = "usb3_vbus", "usb3";
		//function = "usb3";
		mux {
			groups = "usb3_vbus", "usb3";
			function = "usb3";
		};

		ovc {
			pins = "GP_10_10";
			bias-pull-down;
		};

		pwen {
			pins = "GP_10_9";
			bias-pull-up;
		};

		vbus {
			pins = "GP_10_11";
			bias-pull-up;
		};
	};
};

&rswitch3 {
	pinctrl-0 = <&rsw3_pins>, <&eth25g2_pins>, <&ethes0_pins>;
	pinctrl-names = "default";
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * NOTE: Only port@4 is configured for R-Car X5H board.
		 * Other ports (0-3, 5-12) are currently unused or not
		 * connected.
		 */
		port@4 {
			reg = <4>;
			renesas,connect_to_xpcs;
			phy-handle = <&dp83869_phy>;
			phy-mode = "sgmii";
			phys = <&eth_pcs 5>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;

				dp83869_phy: ethernet-phy@2 {
					reg = <2>;
					ti,sgmii-interface;
					ti,max-output-impedance;
					ti,refclk-output-enable;
					ti,clk-output-sel = <DP83869_CLK_O_SEL_REF_CLK>;
				};
			};
		};
	};
};

&scif_clk {
	clock-frequency = <26000000>;
};

&usb30 {
	status = "okay";
	pinctrl-0 = <&usb30_pins>;
	pinctrl-names = "default";
	phys = <&mp_phy 3 0>;
	phy-names = "usb3-phy";

	dwc3_usb30@c8800000 {
		compatible = "synopsys,dwc3", "snps,dwc3";
		reg = <0x0 0xc8800000 0x0 0x100000>;
		interrupts = <GIC_SPI 795 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};

&usb31 {
	status = "okay";
	pinctrl-0 = <&usb31_pins>;
	pinctrl-names = "default";
	phys = <&mp_phy 3 1>;
	phy-names = "usb3-phy";

	dwc3_usb31@c8a00000 {
		compatible = "synopsys,dwc3", "snps,dwc3";
		reg = <0x0 0xc8a00000 0x0 0x100000>;
		interrupts = <GIC_SPI 797 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "super-speed-plus";
		dr_mode = "host";

		snps,host-vbus-glitches-quirk;
	};
};

&usb20 {
	status = "okay";
	pinctrl-0 = <&usb20_pins>;
	pinctrl-names = "default";

	dwc3_usb20@c8900000 {
		compatible = "synopsys,dwc3", "snps,dwc3";
		reg = <0x0 0xc8900000 0x0 0x100000>;
		interrupts = <GIC_SPI 796 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};

&usb21 {
	status = "okay";
	pinctrl-0 = <&usb21_pins>;
	pinctrl-names = "default";

	dwc3_usb21@c8b00000 {
		compatible = "synopsys,dwc3", "snps,dwc3";
		reg = <0x0 0xc8b00000 0x0 0x100000>;
		interrupts = <GIC_SPI 798 IRQ_TYPE_LEVEL_HIGH>;
		maximum-speed = "high-speed";
		dr_mode = "host";
	};
};
