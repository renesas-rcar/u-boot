if RCAR_64

config SYS_MALLOC_F_LEN
	default 0x8000 if RCAR_64

config OF_LIBFDT_OVERLAY
	default y if RCAR_64

config TEXT_BASE
	default 0x50000000 if RCAR_64 && !RCAR_GEN5
	default 0x8E300000 if RCAR_GEN5

source "arch/arm/mach-renesas/Kconfig.rcar3"
source "arch/arm/mach-renesas/Kconfig.rcar4"
source "arch/arm/mach-renesas/Kconfig.rcar5"

endif
